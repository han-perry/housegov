  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build:client && tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "npm run build:client && tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p client --noEmit",
    "build:client": "esbuild client/app.ts client/editor.ts client/orgchart.ts --bundle --minify --sourcemap --outdir=public/build --target=es2020",
    "dev:client": "esbuild client/app.ts client/editor.ts client/orgchart.ts --bundle --sourcemap --outdir=public/build --target=es2020 --watch"
  },
