    "d3-org-chart": "^3.1.1",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
