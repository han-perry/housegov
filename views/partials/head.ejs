<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · HouseGov' : 'HouseGov' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <% if (locals.useEditor) { %><link rel="stylesheet" href="/static/build/editor.css"><% } %>
  <% if (locals.useDiff) { %><link rel="stylesheet" href="/vendor/diff2html/css/diff2html.min.css"><% } %>
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/build/app.js"></script>
  <% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head>
<body>
<nav class="navbar navbar-expand-md hg-nav">
  <div class="container">
    <a class="navbar-brand" href="/">HouseGov</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Menu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <% const nav = [['/proposals','Proposals'],['/meetings','Meetings'],['/polls','Elections & Votes'],['/docs','Policies'],['/orgchart','Org Chart']]; %>
        <% nav.forEach(([href, label]) => { %>
          <li class="nav-item"><a class="nav-link <%= path.startsWith(href) ? 'active' : '' %>" href="<%= href %>"><%= label %></a></li>
        <% }) %>
      </ul>
      <ul class="navbar-nav">
        <% if (user && user.hasPermission(GOVPERMS.PROPOSE)) { %>
          <li class="nav-item"><a class="btn btn-sm btn-dark me-2" href="/proposals/new">Submit proposal</a></li>
        <% } %>
        <% if (user) { %>
          <li class="nav-item"><span class="navbar-text small"><%= user.username %></span></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/dev">Sign in</a></li>
        <% } %>
        <% if (config.devAuth) { %><li class="nav-item"><a class="nav-link small text-danger" href="/dev">dev</a></li><% } %>
      </ul>
    </div>
  </div>
</nav>
<main class="container py-4">
  <% flash.forEach(f => { %>
    <div class="alert alert-<%= f.type %> alert-dismissible fade show" role="alert"><%= f.message %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
  <% }) %>
