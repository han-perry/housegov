<%- include('../partials/head') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Policy Documents</h1>
  <% if (user && user.hasPermission(GOVPERMS.DOCS_MANAGE)) { %><a class="btn btn-dark" href="<%= base %>/docs/new" aria-label="New document" title="New document"><%- icon('plus-lg') %><span class="hg-label">New document</span></a><% } %>
</div>
<div class="row g-4">
  <div class="col-lg-7">
    <% byCategory.forEach(([cat, docs]) => { %>
      <h2 class="h6 text-uppercase text-secondary mt-3"><%= cat %></h2>
      <div class="list-group">
        <% docs.forEach(d => { %><a class="list-group-item list-group-item-action" href="<%= base %>/docs/<%= d.slug %>"><%= d.title %></a><% }) %>
      </div>
    <% }) %>
  </div>
  <div class="col-lg-5">
    <% if (myDrafts.length) { %>
      <h2 class="h6">My amendment drafts</h2>
      <ul class="list-unstyled"><% myDrafts.forEach(a => { %><li><a href="<%= base %>/docs/amendments/<%= a.id %>"><%= a.title || 'Untitled amendment' %></a> <span class="meta"><%= a.doc_slug %> · <%= a.status %></span></li><% }) %></ul>
    <% } %>
    <h2 class="h6 mt-3">Pending amendments</h2>
    <ul class="list-unstyled">
      <% pending.forEach(a => { %><li><a href="<%= base %>/docs/amendments/<%= a.id %>"><%= a.title %></a> <span class="meta"><%= a.doc_title %> · <%= a.status %></span></li><% }) %>
      <% if (!pending.length) { %><li class="text-secondary small">None.</li><% } %>
    </ul>
  </div>
</div>
<% if (deleted.length) { %>
  <details class="mt-4 small">
    <summary class="text-secondary">Deleted documents (<%= deleted.length %>)</summary>
    <ul class="list-unstyled mt-2">
      <% deleted.forEach(d => { %>
        <li class="d-flex align-items-center gap-2 mb-1">
          <span><%= d.title %> <span class="meta">(<%= d.slug %>) · deleted <%= fmtDate(d.deleted_at, { dateOnly: true }) %> by <%= d.deleted_by %></span></span>
          <form method="post" action="<%= base %>/docs/<%= d.slug %>/undelete"><button class="btn btn-sm btn-outline-secondary py-0" aria-label="Restore <%= d.title %>" title="Restore document"><%- icon('arrow-counterclockwise') %><span class="hg-label">Restore</span></button></form>
        </li>
      <% }) %>
    </ul>
  </details>
<% } %>
<%- include('../partials/foot') %>
