<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= doc.title %></title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    body { font-family: "IBM Plex Serif", Georgia, serif; line-height: 1.6; color: #18181b; max-width: 46rem; margin: 0 auto; padding: 1rem; background: #fff; }
    h1, h2, h3 { line-height: 1.25; }
    .src { font: 12px system-ui, sans-serif; color: #71717a; border-top: 1px solid #e4e4e7; margin-top: 2rem; padding-top: .5rem; }
  </style>
</head>
<body>
  <%- html %>
  <div class="src">Source: <a href="<%= config.baseUrl %>/docs/<%= doc.slug %>" target="_blank" rel="noopener">HouseGov · <%= doc.title %></a> (with full revision history)</div>
</body>
</html>
