<%- include('../partials/head', { useEditor: true }) %>
<h1 class="h3">New policy document</h1>
<form method="post" action="<%= base %>/docs" class="card card-body">
  <div class="row g-3 mb-3">
    <div class="col-md-5"><label class="form-label fw-medium" for="title">Title</label><input class="form-control" id="title" name="title" required></div>
    <div class="col-md-4"><label class="form-label fw-medium" for="slug">URL slug</label><div class="input-group"><span class="input-group-text">/docs/</span><input class="form-control" id="slug" name="slug" pattern="[a-z0-9][a-z0-9\-]*" required></div></div>
    <div class="col-md-3"><label class="form-label fw-medium" for="category">Category</label><input class="form-control" id="category" name="category" value="Policy" list="cats"><datalist id="cats"><option>Constitution</option><option>Bylaws</option><option>Policy</option></datalist></div>
  </div>
  <textarea name="content" hidden></textarea>
  <div data-md-editor="content" data-mode="markdown" data-height="420px"></div>
  <div class="mt-3"><button class="btn btn-dark"><%- icon('plus-lg') %> Create document</button></div>
</form>
<script>
  document.getElementById('title').addEventListener('input', (e) => {
    const s = document.getElementById('slug');
    if (!s.dataset.touched) s.value = e.target.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  });
  document.getElementById('slug').addEventListener('input', (e) => { e.target.dataset.touched = 1; });
</script>
<%- include('../partials/foot', { useEditor: true }) %>
