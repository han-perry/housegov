<%- include('../partials/head') %>
<h1 class="h4">History: <a href="<%= base %>/docs/<%= doc.slug %>" class="text-reset"><%= doc.title %></a></h1>
<div class="list-group mt-3">
  <% commits.forEach((c, i) => { %>
    <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <a href="<%= base %>/docs/<%= doc.slug %>/commits/<%= c.sha %>" class="fw-medium"><%= c.subject %></a>
        <div class="meta"><%= c.author %> · <%= fmtDate(c.date) %> · <code><%= c.sha.slice(0, 7) %></code><%= i === 0 ? ' · current' : '' %></div>
      </div>
      <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-secondary" href="<%= base %>/docs/<%= doc.slug %>/commits/<%= c.sha %>" aria-label="Changes" title="Changes"><%- icon('file-diff') %><span class="hg-label">Changes</span></a>
        <a class="btn btn-outline-secondary" href="<%= base %>/docs/<%= doc.slug %>?rev=<%= c.sha %>" aria-label="View this version" title="View this version"><%- icon('eye') %><span class="hg-label">View this version</span></a>
      </div>
    </div>
  <% }) %>
</div>
<%- include('../partials/foot') %>
