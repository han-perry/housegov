<%- include('../partials/head') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">House Meetings</h1>
  <% if (user && user.hasPermission(GOVPERMS.MANAGE)) { %><a class="btn btn-dark" href="/meetings/new">Schedule a meeting</a><% } %>
</div>

<% if (upcoming.length) { %>
  <h2 class="h5">Upcoming</h2>
  <div class="list-group mb-4">
    <% upcoming.forEach(m => { %>
      <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div><a href="/meetings/<%= m.id %>" class="fw-medium"><%= m.title %></a> <span class="meta">— <%= fmtDate(m.meeting_at) %><%= m.status === 'live' ? ' · LIVE' : '' %></span></div>
        <div class="btn-group btn-group-sm">
          <a class="btn btn-outline-secondary" href="/meetings/<%= m.id %>/live">Live view</a>
          <% if (user && user.hasPermission(GOVPERMS.MANAGE)) { %><a class="btn btn-outline-secondary" href="/meetings/<%= m.id %>/manage">Manage agenda</a><% } %>
          <% if (user && user.hasPermission([GOVPERMS.PRESENTATION, GOVPERMS.MANAGE])) { %><a class="btn btn-dark" href="/meetings/<%= m.id %>/console">Presenter console</a><% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<h2 class="h5">Past meetings</h2>
<form class="mb-3" style="max-width: 30rem"><div class="input-group">
  <input name="q" value="<%= q %>" class="form-control" placeholder="Search minutes, agenda items and proposals">
  <button class="btn btn-outline-secondary">Search</button>
</div></form>
<% if (!byTerm.length) { %><p class="text-secondary">No meetings found.</p><% } %>
<% byTerm.forEach(t => { %>
  <h3 class="h6 mt-3 text-uppercase text-secondary"><%= t.term %></h3>
  <ul>
    <% t.meetings.forEach(m => { %><li><a href="/meetings/<%= m.id %>"><%= m.title %></a> <span class="meta">— <%= fmtDate(m.meeting_at, {dateOnly: true}) %></span></li><% }) %>
  </ul>
<% }) %>
<%- include('../partials/foot') %>
