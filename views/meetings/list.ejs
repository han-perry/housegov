<%- include('../partials/head') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">House Meetings</h1>
  <% if (user && user.hasPermission(GOVPERMS.MANAGE)) { %><a class="btn btn-dark" href="<%= base %>/meetings/new" aria-label="Schedule a meeting" title="Schedule a meeting"><%- icon('calendar-plus') %><span class="hg-label">Schedule a meeting</span></a><% } %>
</div>

<% if (upcoming.length) { %>
  <h2 class="h5">Upcoming</h2>
  <div class="list-group mb-4">
    <% upcoming.forEach(m => { %>
      <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div><a href="<%= base %>/meetings/<%= m.id %>" class="fw-medium"><%= m.title %></a> <span class="meta">— <%= fmtDate(m.meeting_at) %><%= m.status === 'live' ? ' · LIVE' : '' %></span></div>
        <div class="btn-group btn-group-sm">
          <a class="btn btn-outline-secondary" href="<%= base %>/meetings/<%= m.id %>/live" aria-label="Live view" title="Live view"><%- icon('broadcast') %><span class="hg-label">Live view</span></a>
          <% if (user && user.hasPermission(GOVPERMS.MANAGE)) { %><a class="btn btn-outline-secondary" href="<%= base %>/meetings/<%= m.id %>/manage" aria-label="Manage agenda" title="Manage agenda"><%- icon('list-ol') %><span class="hg-label">Manage agenda</span></a><% } %>
          <% if (user && user.hasPermission([GOVPERMS.PRESENTATION, GOVPERMS.MANAGE])) { %><a class="btn btn-dark" href="<%= base %>/meetings/<%= m.id %>/console" aria-label="Presenter console" title="Presenter console"><%- icon('display') %><span class="hg-label">Presenter console</span></a><% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<h2 class="h5">Past meetings</h2>
<form class="mb-3" style="max-width: 30rem"><div class="input-group">
  <input name="q" value="<%= q %>" class="form-control" placeholder="Search minutes, agenda items and proposals">
  <button class="btn btn-outline-secondary" aria-label="Search" title="Search"><%- icon('search') %><span class="hg-label">Search</span></button>
</div></form>
<% if (!byTerm.length) { %><p class="text-secondary">No meetings found.</p><% } %>
<% byTerm.forEach(t => { %>
  <h3 class="h6 mt-3 text-uppercase text-secondary"><%= t.term %></h3>
  <ul>
    <% t.meetings.forEach(m => { %><li><a href="<%= base %>/meetings/<%= m.id %>"><%= m.title %></a> <span class="meta">— <%= fmtDate(m.meeting_at, {dateOnly: true}) %></span></li><% }) %>
  </ul>
<% }) %>
<%- include('../partials/foot') %>
