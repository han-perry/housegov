<%- include('../partials/head') %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h1 class="h3 mb-0">Manage: <%= m.title %></h1>
  <div class="btn-group btn-group-sm">
    <a class="btn btn-outline-secondary" href="<%= base %>/meetings/<%= m.id %>">Public agenda</a>
    <a class="btn btn-dark" href="<%= base %>/meetings/<%= m.id %>/console">Presenter console</a>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <h2 class="h5">Agenda <span class="meta fw-normal">(drag to reorder)</span></h2>
    <ul class="list-group mb-3" id="agenda">
      <% items.forEach(i => { %>
        <li class="list-group-item agenda-item" draggable="true" data-id="<%= i.id %>">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <span class="text-secondary me-1">⋮⋮</span>
              <% if (i.kind === 'block') { %>
                <span class="fw-medium"><%= i.title %></span> <span class="badge text-bg-light border">content</span>
              <% } else { %>
                <a href="<%= base %>/proposals/<%= i.proposal_id %>" class="fw-medium">#<%= i.proposal_id %>: <%= i.p_title %></a>
                <span class="meta">— <%= TYPES[i.p_type].label %> by <%= i.p_author %></span>
              <% } %>
            </div>
            <form method="post" action="<%= base %>/meetings/<%= m.id %>/items/<%= i.id %>/delete" onsubmit="return confirm('Remove from agenda?')"><button class="btn btn-sm btn-link text-danger p-0">remove</button></form>
          </div>
          <% if (i.kind === 'block') { %>
            <details class="mt-2">
              <summary class="small">Edit content</summary>
              <form method="post" action="<%= base %>/meetings/<%= m.id %>/items/<%= i.id %>" class="mt-2">
                <input name="title" value="<%= i.title %>" class="form-control form-control-sm mb-1">
                <textarea name="body" class="form-control form-control-sm font-mono" rows="5" placeholder="Markdown. Each bullet becomes a line on the slide."><%= i.body %></textarea>
                <button class="btn btn-sm btn-outline-dark mt-1">Save</button>
              </form>
            </details>
          <% } %>
        </li>
      <% }) %>
    </ul>

    <details class="card card-body mb-4">
      <summary class="fw-medium">Add a content block</summary>
      <form method="post" action="<%= base %>/meetings/<%= m.id %>/items" class="mt-2">
        <input name="title" class="form-control mb-2" placeholder="Title (e.g. Treasurer's Report)" required>
        <textarea name="body" class="form-control font-mono mb-2" rows="5" placeholder="Markdown content"></textarea>
        <button class="btn btn-dark btn-sm">Add block</button>
      </form>
    </details>
  </div>

  <div class="col-lg-5">
    <h2 class="h5">Open proposals</h2>
    <div class="list-group mb-4">
      <% open.forEach(p => { %>
        <div class="list-group-item d-flex justify-content-between align-items-center">
          <div><a href="<%= base %>/proposals/<%= p.id %>">#<%= p.id %>: <%= p.title %></a><div class="meta"><%= TYPES[p.type].label %> · <%= p.author %> · <%= fmtDate(p.created_at, {dateOnly: true}) %><%= new Date(p.created_at) > new Date(m.cutoff_at) ? ' · after cutoff' : '' %></div></div>
          <form method="post" action="<%= base %>/proposals/<%= p.id %>/agenda"><input type="hidden" name="meeting_id" value="<%= m.id %>"><button class="btn btn-sm btn-outline-dark">Add</button></form>
        </div>
      <% }) %>
      <% if (!open.length) { %><div class="list-group-item text-secondary">No open proposals.</div><% } %>
    </div>

    <h2 class="h5">Meeting details</h2>
    <form method="post" action="<%= base %>/meetings/<%= m.id %>" class="card card-body">
      <label class="form-label small" for="title">Title</label>
      <input class="form-control mb-2" id="title" name="title" value="<%= m.title %>">
      <label class="form-label small" for="meeting_at">Meeting time</label>
      <input type="datetime-local" class="form-control mb-2" id="meeting_at" name="meeting_at" value="<%= toLocalInput(m.meeting_at) %>">
      <label class="form-label small" for="cutoff_at">Proposal cutoff</label>
      <input type="datetime-local" class="form-control mb-2" id="cutoff_at" name="cutoff_at" value="<%= toLocalInput(m.cutoff_at) %>">
      <label class="form-label small" for="preface">Preface</label>
      <textarea class="form-control mb-2" id="preface" name="preface" rows="3"><%= m.preface %></textarea>
      <div><button class="btn btn-sm btn-dark">Save</button></div>
    </form>
  </div>
</div>

<script>
  // Minimal native drag-and-drop reordering.
  (() => {
    const list = document.getElementById('agenda');
    let dragging = null;
    list.addEventListener('dragstart', (e) => { dragging = e.target.closest('.agenda-item'); dragging?.classList.add('dragging'); });
    list.addEventListener('dragend', async () => {
      dragging?.classList.remove('dragging');
      dragging = null;
      const order = [...list.querySelectorAll('.agenda-item')].map((li) => li.dataset.id);
      await hg.postJSON('/meetings/<%= m.id %>/order', { order });
    });
    list.addEventListener('dragover', (e) => {
      e.preventDefault();
      const after = [...list.querySelectorAll('.agenda-item:not(.dragging)')].find((li) => e.clientY < li.getBoundingClientRect().top + li.offsetHeight / 2);
      if (dragging) after ? list.insertBefore(dragging, after) : list.appendChild(dragging);
    });
  })();
</script>
<%- include('../partials/foot') %>
