<%- include('partials/head') %>
<div class="row g-4">
  <div class="col-lg-8">
    <% if (next) { %>
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="meta text-uppercase">Next house meeting</div>
              <h2 class="h4 mb-1"><a href="<%= base %>/meetings/<%= next.id %>" class="text-reset"><%= next.title %></a></h2>
              <div class="meta"><%= fmtDate(next.meeting_at) %></div>
            </div>
            <% if (next.status === 'live') { %>
              <a class="btn btn-danger" href="<%= base %>/meetings/<%= next.id %>/live">● Live now: join</a>
            <% } %>
          </div>
          <div class="mt-3 countdown-digits" data-countdown="<%= new Date(next.meeting_at).toISOString() %>" data-start="<%= countdownStart && new Date(countdownStart).toISOString() %>" data-progress="meeting-bar"></div>
          <div class="progress mt-2" style="height: 10px" role="progressbar" aria-label="Time until meeting">
            <div class="progress-bar bg-dark" id="meeting-bar" style="width: 0%"></div>
          </div>
          <div class="mt-3 small">
            <% if (new Date() < new Date(next.cutoff_at)) { %>
              Proposal cutoff: <b><%= fmtDate(next.cutoff_at) %></b> (<span data-countdown="<%= new Date(next.cutoff_at).toISOString() %>" data-style="inline"></span> left).
              Proposals submitted before then will be considered at this meeting.
            <% } else { %>
              The proposal cutoff for this meeting has passed. New proposals will go to the following meeting.
            <% } %>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="card"><div class="card-body text-secondary">No meeting is scheduled yet.
        <% if (user && user.hasPermission(GOVPERMS.MANAGE)) { %><a href="<%= base %>/meetings/new">Schedule one</a>.<% } %>
      </div></div>
    <% } %>

    <h3 class="h5 mt-4">Open proposals</h3>
    <div class="list-group">
      <% openProposals.forEach(p => { %>
        <a class="list-group-item list-group-item-action" href="<%= base %>/proposals/<%= p.id %>">
          <span class="text-secondary">#<%= p.id %></span> <%= p.title %>
          <span class="meta float-end"><%= p.author %> · <%= fmtDate(p.created_at, {dateOnly: true}) %></span>
        </a>
      <% }) %>
      <% if (!openProposals.length) { %><div class="list-group-item text-secondary">No open proposals.</div><% } %>
    </div>
  </div>

  <div class="col-lg-4">
    <h3 class="h5">Voting now</h3>
    <div class="list-group mb-4">
      <% openPolls.forEach(p => { %>
        <a class="list-group-item list-group-item-action" href="<%= base %>/polls/<%= p.id %>">
          <div class="fw-medium"><%= p.title %></div>
          <div class="meta">Closes in <span data-countdown="<%= new Date(p.closes_at).toISOString() %>" data-style="inline"></span></div>
        </a>
      <% }) %>
      <% if (!openPolls.length) { %><div class="list-group-item text-secondary">Nothing open.</div><% } %>
    </div>

    <h3 class="h5">Recent meetings</h3>
    <ul class="list-unstyled">
      <% pastMeetings.forEach(m => { %>
        <li><a href="<%= base %>/meetings/<%= m.id %>"><%= m.title %></a> <span class="meta">— <%= fmtDate(m.meeting_at, {dateOnly: true}) %></span></li>
      <% }) %>
    </ul>
    <form action="<%= base %>/proposals" class="mt-4">
      <label class="form-label small text-secondary" for="q">Search proposals (or enter a number)</label>
      <div class="input-group"><input id="q" name="q" class="form-control" placeholder="e.g. projector, #42"><button class="btn btn-outline-secondary">Search</button></div>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
