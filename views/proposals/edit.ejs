<%- include('../partials/head', { useEditor: true }) %>
<h1 class="h4"><%= can.text ? 'Edit proposal' : 'Edit funding for proposal' %> #<%= p.id %>: <%= p.title %></h1>
<p class="text-secondary small">Changes are logged in the proposal's history. The original submitted official text is kept.</p>
<form method="post" action="<%= base %>/proposals/<%= p.id %>/edit" class="card card-body">
  <input type="hidden" name="return" value="<%= returnTo %>">
  <% if (can.funding) { %>
    <div class="row g-3 mb-3">
      <div class="col-sm-auto" style="min-width: 14rem">
        <label class="form-label fw-medium" for="final_amount">Funding amount</label>
        <div class="input-group"><span class="input-group-text">$</span><input class="form-control" id="final_amount" name="final_amount" value="<%= p.funding.final_amount %>"></div>
      </div>
      <div class="col-sm-auto" style="min-width: 16rem">
        <label class="form-label fw-medium" for="account_number">Existing account number</label>
        <input class="form-control" id="account_number" name="account_number" value="<%= p.funding.account_number || '' %>" placeholder="Blank = new account" maxlength="40" autocomplete="off">
      </div>
    </div>
  <% } %>
  <% if (can.text) { %>
  <div class="mb-3">
    <label class="form-label fw-medium">Unofficial summary</label>
    <textarea name="summary" hidden><%= p.summary %></textarea>
    <div data-md-editor="summary" data-height="220px"></div>
    <div class="form-text d-flex justify-content-between">
      <span>Sent out with the agenda and shown on the big screen.</span>
      <span id="wordcount" class="text-nowrap ms-2"></span>
    </div>
  </div>
  <label class="form-label fw-medium">Official full text</label>
  <textarea name="final_text" hidden><%= p.final_text %></textarea>
  <div data-md-editor="final_text" data-height="420px"></div>
  <% } else if (p.funding) { %>
    <p class="small text-secondary mb-0">The funding was requested as $<%= p.funding.amount %>. You can change the amount and the account; the summary and official text are edited by the House Chair.</p>
  <% } %>
  <div class="mt-3"><button class="btn btn-dark"><%- icon('check-lg') %> Save changes</button> <a href="<%= url(returnTo) %>" class="btn btn-link">Cancel</a></div>
</form>
<% if (can.text) { %>
<script>
  (() => {
    const limit = <%= wordLimit %>;
    const ta = document.querySelector('textarea[name=summary]');
    const out = document.getElementById('wordcount');
    const update = () => {
      const n = ta.value.trim().split(/\s+/).filter(Boolean).length;
      out.textContent = `${n} / ${limit} words`;
      out.className = 'text-nowrap ms-2 ' + (n > limit ? 'text-danger fw-semibold' : '');
    };
    ta.addEventListener('input', update);
    update();
  })();
</script>
<% } %>
<%- include('../partials/foot', { useEditor: true }) %>
