<%- include('../partials/head', { useEditor: true }) %>
<h1 class="h3">Submit Proposal to the House</h1>

<% if (consideration.meeting) { %>
  <div class="alert <%= consideration.missedCutoff ? 'alert-warning' : 'alert-success' %> d-flex justify-content-between align-items-center">
    <div>
      <% if (!consideration.missedCutoff) { %>
        If you submit now, your proposal can be considered at <b><%= consideration.meeting.title %></b> (<%= fmtDate(consideration.meeting.meeting_at) %>).
      <% } else { %>
        The cutoff for <b><%= consideration.meeting.title %></b> has passed. If you submit now, your proposal will be considered at the <b>following</b> meeting.
      <% } %>
    </div>
    <% if (!consideration.missedCutoff) { %><div class="small text-nowrap ms-3">Cutoff in <b data-countdown="<%= new Date(consideration.meeting.cutoff_at).toISOString() %>" data-style="inline"></b></div><% } %>
  </div>
<% } else { %>
  <div class="alert alert-secondary">No meeting is scheduled yet. Your proposal will be considered at the next meeting.</div>
<% } %>

<% if (errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" action="/proposals" id="proposal-form" class="card card-body shadow-sm">
  <div class="mb-3">
    <label class="form-label fw-medium">Primary Author</label>
    <div><%= user.username %></div>
  </div>

  <div class="mb-3">
    <label class="form-label fw-medium" for="coauthors">Secondary Authors (optional)</label>
    <input class="form-control" id="coauthors" name="coauthors" value="<%= values.coauthors || '' %>">
    <div class="form-text">If this proposal is being submitted on behalf of a committee, include the committee title here.</div>
  </div>

  <div class="mb-3">
    <label class="form-label fw-medium" for="title">Proposal Title</label>
    <input class="form-control" id="title" name="title" value="<%= values.title || '' %>" required>
    <div class="form-text">Keep the title concise and to the point. If this proposal has been approved by a specific committee, prefix the title with the committee name, ex. "Tech - ." This will appear on the summary agenda sent out to the House before the meeting.</div>
  </div>

  <fieldset class="mb-3">
    <legend class="form-label fw-medium fs-6">Procedure</legend>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="type" id="t-amendment" value="amendment" <%= values.type === 'amendment' ? 'checked' : '' %>>
      <label class="form-check-label" for="t-amendment">This proposal is a <b>constitutional amendment</b> and requires a 2/3 approval vote.</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="type" id="t-fundrequest" value="fundrequest" <%= values.type === 'fundrequest' ? 'checked' : '' %>>
      <label class="form-check-label" for="t-fundrequest">This proposal requests <b>House funds</b> in the amount of</label>
      <span class="d-inline-flex align-items-center gap-1">
        $<input type="text" inputmode="decimal" class="form-control form-control-sm d-inline-block" style="width: 7rem" name="amount" value="<%= values.amount || '' %>" aria-label="Amount">
      </span>
      and requires a majority approval.
      <details>
        <summary>Account Details</summary>        
        <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
          <label class="small" for="account">Add to existing account <span class="text-secondary">(optional)</span></label>
          <input type="text" class="form-control form-control-sm" style="width: 12rem" id="account" name="account" value="<%= values.account || '' %>" placeholder="Blank = new account" maxlength="40" autocomplete="off">
        </div>
        <div class="form-text">If you don't know an appropriate account, leave blank to create a new account.</div>
      </details>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="type" id="t-policy" value="policy" <%= values.type === 'policy' ? 'checked' : '' %>>
      <label class="form-check-label" for="t-policy">This proposal seeks an <b>official House opinion or policy</b> and requires a majority approval.</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="type" id="t-announcement" value="announcement" <%= values.type === 'announcement' ? 'checked' : '' %>>
      <label class="form-check-label" for="t-announcement">This proposal is <b>only an announcement</b> and requires no approval vote.</label>
    </div>

    <label class="form-label mt-3 mb-1" for="special_notes">Include any special procedural notes here:</label>
    <input class="form-control" id="special_notes" name="special_notes" value="<%= values.special_notes || '' %>">
  </fieldset>

  <div class="mb-3">
    <label class="form-label fw-medium">Attachments: policy document amendments</label>
    <% if (drafts.length) { %>
      <% drafts.forEach(d => { %>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="amendments" value="<%= d.id %>" id="am-<%= d.id %>" <%= values.amendments.includes(String(d.id)) ? 'checked' : '' %>>
          <label class="form-check-label" for="am-<%= d.id %>"><a href="/docs/amendments/<%= d.id %>" target="_blank"><%= d.title %></a> <span class="meta">(<%= d.doc_title %>)</span></label>
        </div>
      <% }) %>
      <div class="form-text">Attached amendments are locked once you submit, and are applied to the document if the House approves this proposal.</div>
    <% } else { %>
      <div class="form-text">To change the constitution or a policy, open it under <a href="/docs">Policies</a> and click "Propose an amendment". Your draft will show up here.</div>
    <% } %>
  </div>

  <div class="mb-3">
    <label class="form-label fw-medium">Unofficial Summary</label>
    <textarea name="summary" hidden><%= values.summary || '' %></textarea>
    <div data-md-editor="summary" data-height="220px"></div>
    <div class="form-text d-flex justify-content-between">
      <span>This description will be sent out with the agenda, and displayed on the big screen during your presentation.</span>
      <span id="wordcount" class="text-nowrap ms-2"></span>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label fw-medium">Official Full text of Proposal</label>
    <textarea name="full_text" hidden><%= values.full_text || '' %></textarea>
    <div data-md-editor="full_text" data-height="360px"></div>
    <div class="form-text">This description will be displayed on the big screen during your presentation. It will be visible on the Database. <b>This is what the House Committee will vote on.</b> Therefore, even if the summary is exactly what the House will vote on, please paste the summary here.</div>
  </div>

  <p>This proposal will be publicly viewable on HouseGov and during House Committee meetings. You cannot undo this action after clicking "Submit Proposal".</p>
  <div><button class="btn btn-dark" type="submit">Submit Proposal</button></div>
</form>

<script>
  (() => {
    const limit = <%= wordLimit %>;
    const ta = document.querySelector('textarea[name=summary]');
    const out = document.getElementById('wordcount');
    const update = () => {
      const n = ta.value.trim().split(/\s+/).filter(Boolean).length;
      out.textContent = `${n} / ${limit} words`;
      out.className = 'text-nowrap ms-2 ' + (n > limit ? 'text-danger fw-semibold' : '');
    };
    ta.addEventListener('input', update);
    update();
  })();
</script>
<%- include('../partials/foot', { useEditor: true }) %>
