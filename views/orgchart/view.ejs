<%- include('../partials/head') %>
<% const canEdit = user && user.hasPermission(GOVPERMS.MANAGE); %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-0">House Government Org Chart</h1>
    <div class="meta">Drag to pan, scroll to zoom, click a role for contact details.</div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <div class="btn-group btn-group-sm" role="group" aria-label="Chart controls">
      <button class="btn btn-outline-secondary" id="org-fit">Fit</button>
      <button class="btn btn-outline-secondary" id="org-expand">Expand all</button>
      <button class="btn btn-outline-secondary" id="org-collapse">Collapse</button>
      <button class="btn btn-outline-secondary" id="org-layout">Rotate</button>
    </div>
    <% if (canEdit) { %><button class="btn btn-sm btn-outline-dark" data-bs-toggle="collapse" data-bs-target="#edit">Edit</button><% } %>
  </div>
</div>

<% if (canEdit) { %>
  <div class="collapse mb-3" id="edit">
    <form method="post" action="<%= base %>/orgchart" class="card card-body">
      <p class="small text-secondary mb-2">One role per line, written <code>Role: username, username</code>. Indent two spaces to put a role under the one above it. A line without a colon is a group heading.</p>
      <textarea name="text" class="form-control font-mono" rows="12"><%= text %></textarea>
      <div class="mt-2"><button class="btn btn-sm btn-dark">Save</button></div>
    </form>
  </div>
<% } %>

<% if (!tree.length) { %>
  <p class="text-secondary">No org chart yet.</p>
<% } else { %>
  <div class="position-relative">
    <div id="orgchart" class="org-canvas" data-mail-domain="<%= config.mailDomain %>"></div>
    <div id="org-details" class="org-details card card-body shadow-sm d-none"></div>
  </div>
  <textarea id="orgchart-data" hidden><%= JSON.stringify(rows) %></textarea>

  <%# Accessible / no-JS fallback: the same tree as a nested list. %>
  <details class="mt-3 small">
    <summary class="text-secondary">Text version</summary>
    <%
      const list = (nodes) => '<ul>' + nodes.map(n => `<li><b>${esc(n.role)}</b>${n.users.length ? ': ' + n.users.map(esc).join(', ') : ''}${n.children.length ? list(n.children) : ''}</li>`).join('') + '</ul>';
      function esc(s) { return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]); }
    %>
    <%- list(tree) %>
  </details>
  <script src="<%= base %>/static/build/orgchart.js" defer></script>
<% } %>
<%- include('../partials/foot') %>
