# Copy to .env (docker compose reads it automatically) and fill in.

# Public URL of the app. The path part is the sub-path it's served under;
# the proxy must pass that path through unchanged (don't strip it).
BASE_URL=https://example.org/housegov

# Long random string: openssl rand -hex 32
SESSION_SECRET=

# 1 = dev login at /dev (anyone can become anyone!). Only behind basic auth / VPN
# until the membrane OIDC connector is wired in.
DEV_AUTH=1

# Host port the app listens on (bound to 127.0.0.1).
# PORT=3000

# Optional
# SMTP_URL=smtp://user:pass@host:587
# DISCORD_WEBHOOK_URL=
